@page
@model ResetPassword

@{
    ViewData["Title"] = "Reset Password";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/ResetPassword.css" asp-append-version="true" />
}


<div class="reset-password-page">


    @* Reset password form *@
    <section class="reset-password-section">

        <div class="reset-password-container">

            <p class="reset-password-eyebrow">
                PAPER & PETALS
            </p>


            <h1>
                Reset Password
            </h1>


            <p class="reset-password-description">
                Choose a new secure password for your account.
            </p>


            @* Viser fejlbesked *@
            @if (TempData["ErrorMessage"] != null)
            {
                <p class="reset-password-error">
                    @TempData["ErrorMessage"]
                </p>
            }


            <form method="post">

                @* Tokenet vises ikke på siden, men sendes med formularen *@
                <input type="hidden" name="token" value="@Model.Token" />


                <div class="form-group">

                    <label for="newPassword">
                        New Password
                    </label>

                    <input type="password"
                           id="newPassword"
                           name="newPassword"
                           autocomplete="new-password"
                           minlength="15"
                           maxlength="64"
                           required />

                    <p class="password-help">
                        Your password must contain between 15 and 64 characters.
                    </p>

                </div>


                <div class="form-group">

                    <label for="confirmPassword">
                        Confirm New Password
                    </label>

                    <input type="password"
                           id="confirmPassword"
                           name="confirmPassword"
                           autocomplete="new-password"
                           minlength="15"
                           maxlength="64"
                           required />

                </div>


                <button type="submit" class="reset-password-button">

                    Reset Password

                </button>


                <a class="back-to-login" asp-page="/Login">

                    Back to Login

                </a>

            </form>

        </div>

    </section>


</div>