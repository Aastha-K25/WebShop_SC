@page
@model Obligatorisk_opgave.Pages.Login

@{
    ViewData["Title"] = "Login";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/Login.css"
          asp-append-version="true" />
}

<section class="login-page">

    <div class="login-container">

        <p class="login-eyebrow">
            PAPER & PETALS
        </p>

        <h1>
            Welcome Back
        </h1>

        <p class="login-description">
            Login to continue your Paper & Petals story.
        </p>


        @if (TempData["SuccessMessage"] != null)
        {
            <p class="login-success">
                @TempData["SuccessMessage"]
            </p>
        }


        @if (TempData["ErrorMessage"] != null)
        {
            <p class="login-error">
                @TempData["ErrorMessage"]
            </p>
        }


        <form method="post">

            <div class="form-group">

                <label for="email">
                    Email
                </label>

                <input type="email"
                       id="email"
                       name="email"
                       autocomplete="email"
                       required />

            </div>


            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <input type="password"
                       id="password"
                       name="password"
                       autocomplete="current-password"
                       required />

            </div>


            <div class="forgot-password-link">

                <a asp-page="/ForgotPassword">
                    Forgot Password?
                </a>

            </div>


            <button type="submit"
                    class="login-button">

                Login

            </button>

        </form>


        <p class="account-link">

            New to Paper & Petals?

            <a asp-page="/Register">
                Create Account
            </a>

        </p>

    </div>

</section>