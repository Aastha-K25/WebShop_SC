@page
@model Obligatorisk_opgave.Pages.Login

@{
    ViewData["Title"] = "Login";
}

<section class="login-page">

    <div class="login-container">

        <p class="login-eyebrow">
            PAPER & PETALS
        </p>

        <h1>Welcome Back</h1>

        <p class="login-description">
            Login to continue your Paper & Petals story.
        </p>


        @* Viser fejlbesked *@
        @if (TempData["ErrorMessage"] != null)
        {
            <p class="login-error">
                @TempData["ErrorMessage"]
            </p>
        }


        @* Login formular *@
        <form method="post">

            <div class="form-group">

                <label for="email">
                    Email
                </label>

                <input type="email"
                       id="email"
                       name="email" />

            </div>


            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <input type="password"
                       id="password"
                       name="password" />

            </div>


            <button type="submit"
                    class="login-button">

                Login

            </button>

        </form>


        <p class="account-link">

            New to Paper & Petals?

            <a asp-page="/Register">
                Create Account
            </a>

        </p>

    </div>

</section>