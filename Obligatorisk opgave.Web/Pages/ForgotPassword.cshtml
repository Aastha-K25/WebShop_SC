@page
@model ForgotPassword

@{
    ViewData["Title"] = "Forgot Password";
}

@section Styles
{
    <link rel="stylesheet"href="~/css/ForgotPassword.css"asp-append-version="true" />
}


<div class="forgot-password-page">


    @* Request password reset *@
    <section class="forgot-password-section">

        <div class="forgot-password-container">

            <p class="forgot-password-eyebrow">
                PAPER & PETALS
            </p>


            <h1>
                Forgot Password?
            </h1>


            <p class="forgot-password-description">
                Enter your email address and we will create a secure
                password reset link for your account.
            </p>


            @* Viser fejlbesked *@
            @if (TempData["ErrorMessage"] != null)
            {
                <p class="forgot-password-error">
                    @TempData["ErrorMessage"]
                </p>
            }


            @* Viser altid en generisk besked efter request *@
            @if (TempData["SuccessMessage"] != null)
            {
                <p class="forgot-password-success">
                    @TempData["SuccessMessage"]
                </p>
            }


            <form method="post">

                <div class="form-group">

                    <label for="email">
                        Email
                    </label>

                    <input type="email"
                           id="email"
                           name="email"
                           autocomplete="email"
                           required />

                </div>


                <button type="submit" class="forgot-password-button">

                    Create Reset Link

                </button>


                <a class="back-to-login" asp-page="/Login">

                    Back to Login

                </a>

            </form>

        </div>

    </section>


</div>