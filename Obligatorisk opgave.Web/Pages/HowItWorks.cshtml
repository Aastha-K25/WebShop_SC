@page
@{
    ViewData["Title"] = "How It Works";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <p class="text-muted">
            PAPER & PETALS
        </p>

        <h1>
            How It Works
        </h1>

        <p class="lead">
            Choose your bouquet, add it to your bag and complete your order.
        </p>

    </div>


    <div class="row g-4">


        <div class="col-md-4">

            <div class="card h-100">

                <div class="card-body text-center">

                    <h2 class="h4">
                        1. Choose a Bouquet
                    </h2>

                    <p class="card-text">
                        Browse our collections and choose the bouquet
                        and book genre you like.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card h-100">

                <div class="card-body text-center">

                    <h2 class="h4">
                        2. Add to Bag
                    </h2>

                    <p class="card-text">
                        Choose your bouquet size and add the product
                        to your shopping bag.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card h-100">

                <div class="card-body text-center">

                    <h2 class="h4">
                        3. Checkout
                    </h2>

                    <p class="card-text">
                        Log in to your account and complete your order
                        through checkout.
                    </p>

                </div>

            </div>

        </div>


    </div>


    <div class="text-center mt-5">

        <a asp-page="/Products"
           class="btn btn-success">

            Explore Bouquets

        </a>

    </div>

</div>