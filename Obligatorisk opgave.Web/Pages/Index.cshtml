@page
@model IndexModel

@{
    ViewData["Title"] = "Paper & Petals";
}

<link rel="stylesheet"
      href="~/css/Index.css"
      asp-append-version="true" />


<div class="front-page">

    <!-- HERO -->
    <section class="hero-section">

        <div class="hero-overlay"></div>

        <div class="page-container hero-content">

            <div class="hero-text">

                <p class="hero-eyebrow">
                    BOOKS • FLOWERS • STORIES
                </p>

                <h1>
                    Flowers that<br />
                    tell a story
                </h1>

                <p class="hero-description">
                    Create your own bouquet with your favorite color
                    and the perfect book.
                </p>

                <a class="primary-button"
                   href="/Products">
                    Explore Bouquets →
                </a>

            </div>

        </div>

    </section>


    <!-- BENEFITS -->
    <section class="benefits-section">

        <div class="page-container benefits-grid">

            <div class="benefit">

                <img class="benefit-icon"
                     src="~/Images/flower-icon.png"
                     alt="Flower icon" />

                <p>
                    Hand-tied<br />
                    with love
                </p>

            </div>


            <div class="benefit">

                <img class="benefit-icon"
                     src="~/Images/delivery-icon.png"
                     alt="Delivery icon" />

                <p>
                    Delivery in 1–3<br />
                    business days
                </p>

            </div>


            <div class="benefit">

                <img class="benefit-icon"
                     src="~/Images/gift-icon.png"
                     alt="Gift icon" />

                <p>
                    The perfect<br />
                    gift
                </p>

            </div>


            <div class="benefit">

                <img class="benefit-icon"
                     src="~/Images/leaf-icon.png"
                     alt="Leaf icon" />

                <p>
                    Sustainable<br />
                    materials
                </p>

            </div>

        </div>

    </section>


    <!-- POPULAR BOUQUETS -->
    <section class="products-section">

        <div class="page-container">

            <div class="products-header">

                <h2>Popular Bouquets</h2>

                <a href="/Products">
                    View All Bouquets →
                </a>

            </div>


            @if (Model.PopularProducts.Count == 0)
            {
                <div class="empty-products">

                    <p>No bouquets have been added yet.</p>

                </div>
            }
            else
            {
                <div class="products-grid">

                    @for (int i = 0; i < Model.PopularProducts.Count; i++)
                    {
                        <a class="product-card"
                           href="/Products?ProductId=@Model.PopularProducts[i].Id"
                           aria-label="Read more about @Model.PopularProducts[i].Name">

                            <div class="product-image-container">

                                <img class="product-image"
                                     src="@Model.PopularProducts[i].ImagePath"
                                     alt="@Model.PopularProducts[i].ImageDescription" />

                            </div>


                            <div class="product-information">

                                <h3>
                                    @Model.PopularProducts[i].Name
                                </h3>

                                <p class="product-genre">
                                    + @Model.PopularProducts[i].BookGenre
                                </p>

                                <p class="product-price">
                                    @Model.PopularProducts[i].Price.ToString("0") kr.
                                </p>

                            </div>

                        </a>
                    }

                </div>
            }


            <div class="products-quote">

                <span></span>

                <p>
                    Books and flowers. A more beautiful world.
                </p>

                <span></span>

            </div>

        </div>


        <!-- ned.png ligger alene nederst -->
        <div class="bottom-decoration"></div>

    </section>

</div>