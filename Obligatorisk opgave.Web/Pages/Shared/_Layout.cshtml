@using Obligatorisk_opgave.Services
@using Obligatoris.opgave.Domain.Models
@using Obligatoris.opgave.Domain.Interfaces

@inject SessionService SessionService
@inject IShoppingCartRepository ShoppingCartRepository

@{
    // Henter den bruger der er logget ind
    User? currentUser =
        SessionService.GetCurrentUser();


    // Bruges til at styre hvad der vises i navbaren
    bool isLoggedIn =
        currentUser != null;

    bool isCustomer =
        currentUser is Customer;

    bool isAdmin =
        currentUser is Admin;


    // Antal varer i shopping bag
    int cartCount = 0;


    // Guest-cart ligger i session
    if (currentUser == null)
    {
        List<ShoppingCartProduct> guestCart =
            SessionService.GetGuestCart();

        cartCount =
            guestCart.Sum(
                item => item.Quantity);
    }


    // Customer-cart ligger i databasen
    if (currentUser is Customer customer)
    {
        ShoppingCart? shoppingCart =
            ShoppingCartRepository.GetByCustomerId(
                customer.Id);


        if (shoppingCart != null)
        {
            List<Product> cartProducts =
                ShoppingCartRepository.GetProducts(
                    shoppingCart.Id);


            foreach (Product product in cartProducts)
            {
                cartCount +=
                    ShoppingCartRepository.GetProductQuantity(
                        shoppingCart.Id,
                        product.Id);
            }
        }
    }
}


<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />


    <title>
        @ViewData["Title"] - Paper & Petals
    </title>


    <script type="importmap"></script>


    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="~/Obligatorisk_opgave.styles.css"
          asp-append-version="true" />


    @await RenderSectionAsync(
    "Styles",
        required: false)

</head>


<body>


    <header>

        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow">

            <div class="container">


                @* Logoet sender Admin til dashboard og andre til forsiden *@
                @if (isAdmin)
                {
                    <a class="navbar-brand"
                       asp-page="/AdminDashboard">

                        <img class="navbar-logo"
                             src="~/Images/logo.png"
                             alt="Paper & Petals logo" />

                        <span>
                            Paper & Petals
                        </span>

                    </a>
                }
                else
                {
                    <a class="navbar-brand"
                       asp-page="/Index">

                        <img class="navbar-logo"
                             src="~/Images/logo.png"
                             alt="Paper & Petals logo" />

                        <span>
                            Paper & Petals
                        </span>

                    </a>
                }


                @* Menuen bruges på mindre skærme *@
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Open navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="mainNavbar">


                    @* Admin får sin egen navigation *@
                    @if (isAdmin)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">


                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-page="/AdminDashboard">

                                    Dashboard

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-page="/AdminProducts">

                                    Products

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-page="/AdminOrders">

                                    Orders

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-page="/AdminUsers">

                                    Customers

                                </a>

                            </li>


                        </ul>
                    }
                    else
                    {
                        @* Navigation til webshoppen *@
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">


                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-page="/Index">

                                    Home

                                </a>

                            </li>


                            @* Dropdown med bouquet-kategorier *@
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle text-dark"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    Bouquets

                                </a>


                                <ul class="dropdown-menu">


                                    <li>

                                        <a class="dropdown-item"
                                           asp-page="/Products">

                                            All Bouquets

                                        </a>

                                    </li>


                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>


                                    <li>

                                        <a class="dropdown-item"
                                           asp-page="/Products"
                                           asp-route-genre="Romance">

                                            Romance

                                        </a>

                                    </li>


                                    <li>

                                        <a class="dropdown-item"
                                           asp-page="/Products"
                                           asp-route-genre="DarkRomance">

                                            Dark Romance

                                        </a>

                                    </li>


                                    <li>

                                        <a class="dropdown-item"
                                           asp-page="/Products"
                                           asp-route-genre="Fantasy">

                                            Fantasy

                                        </a>

                                    </li>


                                    <li>

                                        <a class="dropdown-item"
                                           asp-page="/Products"
                                           asp-route-genre="Crime">

                                            Crime

                                        </a>

                                    </li>


                                    <li>

                                        <a class="dropdown-item"
                                           asp-page="/Products"
                                           asp-route-genre="Biography">

                                            Biography

                                        </a>

                                    </li>


                                </ul>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-page="/HowItWorks">

                                    How It Works

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-page="/About">

                                    About Us

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-page="/Contact">

                                    Contact

                                </a>

                            </li>


                            @* Customer kan gå direkte til egne ordrer *@
                            @if (isCustomer)
                            {
                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-page="/Orders">

                                        My Orders

                                    </a>

                                </li>
                            }


                        </ul>
                    }


                    @* Ikoner og brugermenu i højre side *@
                    <div class="navbar-icons d-flex align-items-center gap-3">


                        @if (isLoggedIn)
                        {
                            <div class="dropdown user-menu">


                                <button class="user-menu-button"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Open user menu">

                                    <img src="~/Images/user-icon.png"
                                         alt="User menu" />

                                </button>


                                <ul class="dropdown-menu dropdown-menu-end">


                                    @* Customer-menu *@
                                    @if (isCustomer)
                                    {
                                        <li>

                                            <a class="dropdown-item"
                                               asp-page="/Account">

                                                My Account

                                            </a>

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-page="/Orders">

                                                My Orders

                                            </a>

                                        </li>


                                        <li>

                                            <a class="dropdown-item"
                                               asp-page="/ChangePassword">

                                                Change Password

                                            </a>

                                        </li>


                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>
                                    }


                                    @* Admin-menu *@
                                    @if (isAdmin)
                                    {
                                        <li>

                                            <a class="dropdown-item"
                                               asp-page="/AdminDashboard">

                                                Admin Dashboard

                                            </a>

                                        </li>


                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>
                                    }


                                    <li>

                                        <a class="dropdown-item"
                                           asp-page="/Logout">

                                            Log Out

                                        </a>

                                    </li>


                                </ul>

                            </div>
                        }
                        else
                        {
                            @* Menu til brugere der ikke er logget ind *@
                            <div class="dropdown user-menu">


                                <button class="user-menu-button"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Open account menu">

                                    <img src="~/Images/user-icon.png"
                                         alt="Account" />

                                </button>


                                <ul class="dropdown-menu dropdown-menu-end">


                                    <li>

                                        <a class="dropdown-item"
                                           asp-page="/Login">

                                            Log In

                                        </a>

                                    </li>


                                    <li>

                                        <a class="dropdown-item"
                                           asp-page="/Register">

                                            Create Account

                                        </a>

                                    </li>


                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>


                                    <li>

                                        <a class="dropdown-item"
                                           asp-page="/AdminLogin">

                                            Admin

                                        </a>

                                    </li>


                                </ul>

                            </div>
                        }


                        @* Kun Guest og Customer har shopping bag *@
                        @if (!isAdmin)
                        {
                            <a asp-page="/Cart"
                               class="position-relative"
                               aria-label="View shopping bag">

                                <img src="~/Images/cart-icon.png"
                                     alt="Shopping bag" />


                                @* Badge vises kun når der er varer i kurven *@
                                @if (cartCount > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">

                                        @cartCount

                                        <span class="visually-hidden">
                                            items in shopping bag
                                        </span>

                                    </span>
                                }

                            </a>
                        }


                    </div>

                </div>

            </div>

        </nav>

    </header>


    @* Her bliver indholdet fra den enkelte side vist *@
    <div class="main-content">

        <main role="main">

            @RenderBody()

        </main>

    </div>


    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - Paper & Petals -

            <a asp-page="/Privacy">
                Privacy
            </a>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync(
    "Scripts",
        required: false)


</body>

</html>
