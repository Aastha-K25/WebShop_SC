@page

@{
    ViewData["Title"] = "About Us";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/InformationPages.css"
          asp-append-version="true" />
}

<section class="about-page">

    <div class="about-page-container">

        <div class="about-page-header">

            <p class="about-page-eyebrow">
                ABOUT PAPER & PETALS
            </p>

            <h1>
                Where stories and flowers meet
            </h1>

            <p>
                Thoughtful gifts created from two simple things:
                beautiful flowers and unforgettable stories.
            </p>

        </div>


        <div class="about-page-grid">

            <div class="about-page-card">

                <p class="about-card-number">
                    01
                </p>

                <h2>
                    Flowers
                </h2>

                <p>
                    Every bouquet is designed to feel personal,
                    beautiful and suitable for a special moment.
                </p>

            </div>


            <div class="about-page-card">

                <p class="about-card-number">
                    02
                </p>

                <h2>
                    Stories
                </h2>

                <p>
                    Our bouquets are paired with different book genres,
                    giving each gift its own mood and personality.
                </p>

            </div>


            <div class="about-page-card">

                <p class="about-card-number">
                    03
                </p>

                <h2>
                    Together
                </h2>

                <p>
                    Paper & Petals brings books and flowers together
                    as one thoughtful and memorable gift.
                </p>

            </div>

        </div>


        <div class="about-page-story">

            <div>

                <p class="about-page-eyebrow">
                    OUR IDEA
                </p>

                <h2>
                    More than a bouquet
                </h2>

            </div>


            <div>

                <p>
                    Paper & Petals combines two meaningful gifts:
                    books and flowers.
                </p>

                <p>
                    Our collections are created around different book genres,
                    so every bouquet can match a mood, a story and a person.
                </p>

                <p>
                    Whether it is romance, fantasy, crime or biography,
                    the idea is simple: give someone something beautiful
                    to read and something beautiful to keep beside them.
                </p>

            </div>

        </div>


        <div class="about-page-actions">

            <a asp-page="/Products"
               class="btn-paper-primary">

                Explore Bouquets

            </a>


            <a asp-page="/Contact"
               class="btn-paper-outline">

                Contact Us

            </a>

        </div>

    </div>

</section>
