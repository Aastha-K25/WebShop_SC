@page
@model Obligatorisk_opgave.Pages.Register

@{
    ViewData["Title"] = "Create Account";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/Register.css"
          asp-append-version="true" />
}

<section class="register-page">

    <div class="register-container">

        <p class="register-eyebrow">
            PAPER & PETALS
        </p>

        <h1>
            Create Account
        </h1>

        <p class="register-description">
            Create an account and keep your favourite stories and blooms close.
        </p>

        @if (TempData["ErrorMessage"] != null)
        {
            <p class="register-error">
                @TempData["ErrorMessage"]
            </p>
        }

        <form method="post">

            <div class="form-group">

                <label for="name">
                    First Name
                </label>

                <input type="text"
                       id="name"
                       name="name"
                       autocomplete="given-name"
                       required />

            </div>

            <div class="form-group">

                <label for="surname">
                    Surname
                </label>

                <input type="text"
                       id="surname"
                       name="surname"
                       autocomplete="family-name"
                       required />

            </div>

            <div class="form-group">

                <label for="email">
                    Email
                </label>

                <input type="email"
                       id="email"
                       name="email"
                       autocomplete="email"
                       required />

            </div>

            <div class="form-group full-width">

                <label for="address">
                    Address
                </label>

                <input type="text"
                       id="address"
                       name="address"
                       autocomplete="street-address"
                       required />

            </div>

            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <input type="password"
                       id="password"
                       name="password"
                       autocomplete="new-password"
                       minlength="15"
                       maxlength="64"
                       aria-describedby="passwordHelp"
                       required />

                <p id="passwordHelp" class="register-description">
                    Use 15 to 64 characters.
                    Avoid common passwords and do not use your
                    name or email as your password.
                </p>

            </div>

            <div class="form-group">

                <label for="confirmPassword">
                    Confirm Password
                </label>

                <input type="password"
                       id="confirmPassword"
                       name="confirmPassword"
                       autocomplete="new-password"
                       minlength="15"
                       maxlength="64"
                       required />

            </div>

            <button type="submit"
                    class="register-button">

                Create Account

            </button>

        </form>

        <p class="account-link">

            Already have an account?

            <a asp-page="/Login">
                Login
            </a>

        </p>

    </div>

</section>
