@page
@model ChangePassword

@{
    ViewData["Title"] = "Change Password";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/ChangePassword.css" asp-append-version="true" />
}


<div class="change-password-page">


    @* Change password form *@
    <section class="change-password-section">

        <div class="change-password-container">

            <p class="change-password-eyebrow">
                PAPER & PETALS
            </p>

            <h1>
                Change Password
            </h1>


            <p class="change-password-description">
                Enter your current password and choose a new secure password.
            </p>


            @* Viser fejlbesked *@
            @if (TempData["ErrorMessage"] != null)
            {
                <p class="change-password-error">
                    @TempData["ErrorMessage"]
                </p>
            }


            <form method="post">


                <div class="form-group">

                    <label for="currentPassword">
                        Current Password
                    </label>

                    <input type="password"
                           id="currentPassword"
                           name="currentPassword"
                           autocomplete="current-password"
                           required />

                </div>


                <div class="form-group">

                    <label for="newPassword">
                        New Password
                    </label>

                    <input type="password"
                           id="newPassword"
                           name="newPassword"
                           autocomplete="new-password"
                           minlength="15"
                           maxlength="64"
                           required />

                    <p class="password-help">
                        Your new password must contain between 15 and 64 characters.
                    </p>

                </div>


                <div class="form-group">

                    <label for="confirmPassword">
                        Confirm New Password
                    </label>

                    <input type="password"
                           id="confirmPassword"
                           name="confirmPassword"
                           autocomplete="new-password"
                           minlength="15"
                           maxlength="64"
                           required />

                </div>


                <button type="submit"class="change-password-button">

                    Change Password

                </button>


                <a class="cancel-button"
                   asp-page="/Index">

                    Cancel

                </a>


            </form>

        </div>

    </section>


</div>