@page
@model Obligatorisk_opgave.Pages.Cart

@{
    ViewData["Title"] = "Cart";
}

<section class="cart-page">

    <h1>Your Cart</h1>

    <div class="cart-layout">

        @* Produkterne i kurven *@
        <div class="cart-items">

            <div class="cart-item">

                <div>
                    <h2>@Model.ProductName</h2>
                    <p>Beautiful bouquet with roses and seasonal flowers.</p>
                </div>

                <div>
                    <p>Quantity: @Model.Quantity</p>
                    <p>@Model.Price kr.</p>

                    @* Knap til at fjerne varen *@
                    <button type="button" class="remove-button">
                        Remove
                    </button>
                </div>

            </div>

        </div>

        @* Ordreoversigt *@
        <div class="cart-summary">

            <h2>Your Order</h2>

            @* Pris for alle varer *@
            <div class="summary-row">
                <span>Items</span>
                <span>@Model.Subtotal kr.</span>
            </div>

            @* Leveringspris *@
            <div class="summary-row">
                <span>Shipping</span>
                <span>@Model.ShippingPrice kr.</span>
            </div>

            <hr />

            @* Samlet pris *@
            <div class="summary-row">
                <strong>Total</strong>
                <strong>@Model.TotalPrice kr.</strong>
            </div>

            @* Knap til checkout *@
            <button type="button" class="checkout-button">
                Proceed to Checkout
            </button>

        </div>

    </div>

</section>